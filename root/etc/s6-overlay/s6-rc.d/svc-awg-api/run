#!/usr/bin/with-contenv bash
# shellcheck shell=bash

if [[ "${USE_API,,}" != "true" ]]; then
    s6-notifyoncheck -d -n 300 -w 1000 -c "echo **** REST API disabled ****" \
        sleep infinity
else
    # Load or generate API token
    if [[ -z "${API_TOKEN}" ]]; then
        if [[ -f /config/server/api_token ]]; then
            API_TOKEN=$(cat /config/server/api_token)
        else
            API_TOKEN=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
            echo "${API_TOKEN}" > /config/server/api_token
            lsiown abc:abc /config/server/api_token
            chmod 600 /config/server/api_token
            echo "**** API token generated: ${API_TOKEN} ****"
            echo "**** Save this token — it will not be shown again ****"
        fi
    fi

    export API_TOKEN
    export API_PORT=${API_PORT:-8081}
    export API_READONLY=${API_READONLY:-true}

    echo "**** Starting REST API on port ${API_PORT} ****"

    exec \
        s6-notifyoncheck -d -n 300 -w 1000 \
            -c "nc -z localhost ${API_PORT}" \
        /usr/bin/awg-api
fi
