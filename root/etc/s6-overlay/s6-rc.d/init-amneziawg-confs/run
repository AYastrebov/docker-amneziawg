#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# shellcheck disable=SC2016,SC1091,SC2183

mkdir -p /config/wg_confs

# migration to subfolder for wg confs
if [[ -z "$(ls -A /config/wg_confs)" ]]; then
    if [[ -f /config/awg0.conf ]]; then
        echo "**** Migrating legacy config /config/awg0.conf -> /config/wg_confs/wg0.conf ****"
        cp /config/awg0.conf /config/wg_confs/wg0.conf
        rm -rf /config/awg0.conf || :
    elif [[ -f /config/wg0.conf ]]; then
        echo "**** Migrating legacy config /config/wg0.conf -> /config/wg_confs/wg0.conf ****"
        cp /config/wg0.conf /config/wg_confs/wg0.conf
        rm -rf /config/wg0.conf || :
    fi
fi

# prepare templates
if [[ ! -f /config/templates/server.conf ]]; then
    cp /defaults/server.conf /config/templates/server.conf
fi
if [[ ! -f /config/templates/peer.conf ]]; then
    cp /defaults/peer.conf /config/templates/peer.conf
fi
# add preshared key to user templates (backwards compatibility)
if ! grep -q 'PresharedKey' /config/templates/peer.conf; then
    sed -i 's|^Endpoint|PresharedKey = \$\(cat /config/\${PEER_ID}/presharedkey-\${PEER_ID}\)\nEndpoint|' /config/templates/peer.conf
fi

# ============================================================================
# AWG obfuscation parameter helpers
# ============================================================================

# AWG_VERSION controls the protocol feature set:
#   "2.0" (default) - Full AWG 2.0: S3/S4 padding, H1-H4 range support,
#                     I1-I5 Custom Protocol Signatures (auto-generated if not set)
#   "3.0"           - AWG 2.0 plus HeaderProtectionKey, ContentPaddingAddition
#                     and randomized protocol timers. Requires 3.0-capable
#                     clients; HeaderProtectionKey must match on all ends.
#   "3.1"           - AWG 3.0 plus RandomTrailers. Upstream 3.1 is not a new
#                     parameter set but two independent [Interface] switches;
#                     this preset turns RandomTrailers on and leaves
#                     DisableCookies off. Both are also settable on their own
#                     via AWG_RANDOM_TRAILERS / AWG_DISABLE_COOKIES with any
#                     AWG_VERSION. Requires 3.1-capable software on every end
#                     that uses them.
#   "1.5"           - Legacy mode: S3=S4=0, no I1-I5 signatures,
#                     compatible with AmneziaVPN < 4.8.12.9
# Left empty on purpose: load_awg_params restores the saved version first, so
# recreating a container without AWG_VERSION keeps the deployment on the
# version its peer confs were built for. The 2.0 default is applied in
# generate_awg_params, after that restore. Defaulting here would make the
# awg_params fallback dead code and silently rewrite every peer conf as 2.0.
AWG_VERSION=${AWG_VERSION:-}

# True when the version carries the AWG 3.x parameter set (header protection,
# content padding, randomized timers).
awg_has_3x_params() {
    [[ "${AWG_VERSION}" == "3.0" || "${AWG_VERSION}" == "3.1" ]]
}

# True when the version carries the AWG 2.0+ feature set (H1-H4 ranges,
# I1-I5 signatures). 3.x builds on 2.0, so it is included.
awg_has_2x_features() {
    [[ "${AWG_VERSION}" == "2.0" ]] || awg_has_3x_params
}

# Generate a random hex string of N bytes (2*N hex chars)
random_hex() {
    local nbytes=$1
    head -c "$nbytes" /dev/urandom | od -An -tx1 | tr -d ' \n'
}

# Normalize an AWG 3.1 on/off switch. Empty stays empty, meaning the key is
# not written at all. An unrecognized value is dropped with a warning rather
# than passed through: awg setconf rejects the entire config on a bad value,
# which would take the tunnel down instead of degrading one option.
normalize_awg_switch() {
    local name=$1 value=$2
    case "${value,,}" in
        "")         printf '' ;;
        on|off)     printf '%s' "${value,,}" ;;
        true|1|yes) printf 'on' ;;
        false|0|no) printf 'off' ;;
        *)
            echo "**** WARNING: ${name}=${value} is not a valid on/off value - ignoring ****" >&2
            printf '' ;;
    esac
}

# Generate default I1 signature for AWG 2.0
# Uses QUIC Initial (RFC 9000) — the same default as the Amnezia app itself.
# QUIC is UDP-native, globally neutral, and the most DPI-resistant option:
# the 1200B minimum (RFC 9000 §14.1) matches real Chrome/Firefox traffic.
# Each connection, <r N> tags produce fresh random bytes so every handshake
# looks unique even though the spec string is fixed.
# For custom protocols (DNS, DTLS, SIP, HTTP/3) use https://architect.vai-rice.space/
generate_default_signatures() {
    # QUIC Initial: Long Header 0xC3 (Initial, 4B pkt_num) | QUIC v1 | 8B random DCID
    # no SCID | no token | length varint 0x449E (=1182) | 4B pkt_num | 1178B random payload
    AWG_I1=${AWG_I1:-"<b 0xc3><b 0x00000001><b 0x08><r 8><b 0x00><b 0x00><b 0x449e><r 4><r 1178>"}
    # I2-I5 are optional; leave empty unless explicitly set
    AWG_I2=${AWG_I2:-}
    AWG_I3=${AWG_I3:-}
    AWG_I4=${AWG_I4:-}
    AWG_I5=${AWG_I5:-}
}

# Extract lower/upper bound of an "lo-hi" range (single value => lo=hi)
range_lo() { echo "${1%%-*}"; }
range_hi() { echo "${1##*-}"; }

# AWG 3.0: header protection key, content padding, randomized timers.
# Ranges follow AmneziaWG-Architect "medium" intensity. Timer semantics:
# amneziawg-go device/timers.go — each side uses its own values.
generate_awg3_params() {
    # Shared symmetric key — must be identical on server and all clients.
    # Use genpsk (full-entropy 32 random bytes, like PresharedKey), NOT genkey
    # (genkey emits a bit-clamped Curve25519 private key — wrong generator for
    # a symmetric ChaCha20 header-protection key).
    AWG_HEADER_PROTECTION_KEY=${AWG_HEADER_PROTECTION_KEY:-$(awg genpsk)}

    # Extra random padding on each transport packet.
    #
    # Left at 0 when RandomTrailers is on, because the two are mutually exclusive
    # in a way that only hurts: content padding takes precedence on the *send*
    # path and suppresses the trailers entirely, while the *receive* path reads
    # the trailers flag directly and still relaxes its packet-type matching. You
    # get the risk of trailers and none of their obfuscation. Content padding
    # also costs ~22% of download throughput on its own, because a different
    # length on every datagram defeats UDP_GRO batching on userspace clients.
    # An explicit AWG_CONTENT_PADDING still wins — this only sets the default.
    # See docs/awg-performance.md.
    if [[ -z "${AWG_CONTENT_PADDING}" ]]; then
        if [[ "${AWG_RANDOM_TRAILERS}" == "on" ]]; then
            AWG_CONTENT_PADDING="0"
        else
            local _lo
            _lo=$(shuf -i 16-72 -n 1)
            AWG_CONTENT_PADDING="${_lo}-$(shuf -i $((_lo + 8))-128 -n 1)"
        fi
    fi
    if [[ -z "${AWG_REKEY_TIMEOUT}" ]]; then
        local _lo
        _lo=$(shuf -i 4-6 -n 1)
        AWG_REKEY_TIMEOUT="${_lo}-$((_lo + $(shuf -i 1-4 -n 1)))"
    fi
    if [[ -z "${AWG_KEEPALIVE_TIMEOUT}" ]]; then
        local _lo
        _lo=$(shuf -i 8-14 -n 1)
        AWG_KEEPALIVE_TIMEOUT="${_lo}-$((_lo + $(shuf -i 2-8 -n 1)))"
    fi
    if [[ -z "${AWG_REKEY_AFTER_TIME}" ]]; then
        local _lo
        _lo=$(shuf -i 100-120 -n 1)
        AWG_REKEY_AFTER_TIME="${_lo}-$((_lo + $(shuf -i 10-25 -n 1)))"
    fi
    if [[ -z "${AWG_REJECT_AFTER_TIME}" ]]; then
        # Must satisfy RejectAfterTime.lo > RekeyAfterTime.hi and
        # RejectAfterTime.lo > KeepaliveTimeout.lo + RekeyTimeout.lo
        local _floor=$(( $(range_hi "${AWG_REKEY_AFTER_TIME}") + $(range_hi "${AWG_KEEPALIVE_TIMEOUT}") + $(range_hi "${AWG_REKEY_TIMEOUT}") + 15 ))
        local _lo=$(( _floor > 170 ? _floor : 170 ))
        AWG_REJECT_AFTER_TIME="${_lo}-$((_lo + $(shuf -i 10-25 -n 1)))"
    fi
    if [[ -z "${AWG_MAX_HANDSHAKE_ATTEMPTS}" ]]; then
        local _lo
        _lo=$(shuf -i 12-18 -n 1)
        AWG_MAX_HANDSHAKE_ATTEMPTS="${_lo}-$((_lo + $(shuf -i 2-10 -n 1)))"
    fi
}

# Generate random AWG obfuscation parameters if not set
generate_awg_params() {
    # Applied here rather than at the top of the script so load_awg_params gets
    # a chance to restore a previously saved version first.
    AWG_VERSION=${AWG_VERSION:-2.0}
    echo "**** AmneziaWG version: ${AWG_VERSION} ****"

    # AWG 3.1 interface switches. Upstream treats these as independent of the
    # parameter set, so they are honoured with any AWG_VERSION; AWG_VERSION=3.1
    # is simply a preset that turns RandomTrailers on. DisableCookies stays
    # opt-in — it gives up WireGuard's built-in DoS mitigation and, unlike
    # RandomTrailers, does not have to match between ends.
    # Normalize what was actually asked for, then let the 3.1 preset fill in a
    # default. Only the explicit value is persisted below: a RandomTrailers
    # that came from AWG_VERSION=3.1 must not outlive a downgrade to 2.0, or a
    # user dropping back to fix an old client would still emit a key that
    # client cannot parse.
    # Resolved here, ahead of the S values, because RandomTrailers constrains
    # how S1-S4 may be drawn (see below).
    local _rt_explicit _dc_explicit _s_all
    _rt_explicit=$(normalize_awg_switch AWG_RANDOM_TRAILERS "${AWG_RANDOM_TRAILERS:-}")
    _dc_explicit=$(normalize_awg_switch AWG_DISABLE_COOKIES "${AWG_DISABLE_COOKIES:-}")
    AWG_RANDOM_TRAILERS="${_rt_explicit}"
    AWG_DISABLE_COOKIES="${_dc_explicit}"
    # "off" is a real value here, not an absence, so it survives s6 and beats
    # both the saved value and this preset.
    if [[ "${AWG_VERSION}" == "3.1" ]]; then
        AWG_RANDOM_TRAILERS=${AWG_RANDOM_TRAILERS:-on}
    fi

    # Core parameters (all versions)
    AWG_JC=${AWG_JC:-$(shuf -i 3-8 -n 1)}
    AWG_JMIN=${AWG_JMIN:-$(shuf -i 40-80 -n 1)}
    AWG_JMAX=${AWG_JMAX:-$(shuf -i 80-250 -n 1)}

    # RandomTrailers relaxes the receiver's packet-type check from an exact
    # length match to a lower bound, which leaves the H ranges as the only thing
    # separating message types — and each type's check reads the type field at
    # *its own* S offset. With unequal S values three of the four checks read the
    # wrong offset and land inside a ~50M-wide H range about 1.16% of the time
    # each, so ~3.5% of transport packets are dropped as malformed handshakes and
    # upload collapses (~100 -> ~2 Mbit/s) while download barely moves. Equal
    # values make every check read the true type field, which the non-overlapping
    # H ranges then reject cleanly. See docs/awg-performance.md.
    # AWG 1.5 is exempt: its single-integer H values are 1 wide, not 50M, so a
    # wrong-offset read matches with probability 2^-32.
    if [[ "${AWG_RANDOM_TRAILERS}" == "on" ]] && awg_has_2x_features; then
        # 12 satisfies the HeaderProtection floor; <= 20 keeps a full-size packet
        # inside 1500 at awg-quick's derived 1420 MTU (overhead is 60 + S4).
        _s_all=$(shuf -i 12-20 -n 1)
        AWG_S1=${AWG_S1:-$_s_all}
        AWG_S2=${AWG_S2:-$_s_all}
        AWG_S3=${AWG_S3:-$_s_all}
        AWG_S4=${AWG_S4:-$_s_all}
        if [[ "$AWG_S1" != "$AWG_S2" || "$AWG_S2" != "$AWG_S3" || "$AWG_S3" != "$AWG_S4" ]]; then
            echo "**** WARNING: RandomTrailers is on but S1-S4 are not all equal ****"
            echo "**** (S1=$AWG_S1 S2=$AWG_S2 S3=$AWG_S3 S4=$AWG_S4). Around 3.5% of transport ****"
            echo "**** packets will be dropped and upload will collapse. Set AWG_S1, ****"
            echo "**** AWG_S2, AWG_S3 and AWG_S4 to the same value, or turn off      ****"
            echo "**** AWG_RANDOM_TRAILERS. See docs/awg-performance.md.             ****"
        fi
    else
        AWG_S1=${AWG_S1:-$(shuf -i 15-150 -n 1)}
        AWG_S2=${AWG_S2:-$(shuf -i 15-150 -n 1)}
    fi

    if awg_has_2x_features; then
        # AWG 2.0/3.x: H1-H4 as non-overlapping range pairs (quadrant strategy, ~50M width each).
        # Range format (e.g. "90666522-140666522") is required for the Amnezia app to detect AWG 2.0+.
        _h1_lo=$(shuf -i 5-486870911 -n 1);          AWG_H1=${AWG_H1:-${_h1_lo}-$((_h1_lo + 50000000))}
        _h2_lo=$(shuf -i 536870912-1023741823 -n 1);  AWG_H2=${AWG_H2:-${_h2_lo}-$((_h2_lo + 50000000))}
        _h3_lo=$(shuf -i 1073741824-1560612735 -n 1); AWG_H3=${AWG_H3:-${_h3_lo}-$((_h3_lo + 50000000))}
        _h4_lo=$(shuf -i 1610612736-2097483647 -n 1); AWG_H4=${AWG_H4:-${_h4_lo}-$((_h4_lo + 50000000))}
        # S4 is capped at 20 rather than the protocol maximum of 32 because it is
        # paid on every transport packet, in bandwidth and in MTU headroom:
        # overhead is 60 + S4 over IPv4, and awg-quick derives a 1420 tunnel MTU
        # without accounting for S4 at all. Above 20, every full-size packet
        # exceeds 1500 and fragments, which many mobile networks and CGNATs drop
        # outright — "connects fine, downloads crawl". S3 is unconstrained here
        # since cookie replies are rare. See docs/awg-performance.md.
        if awg_has_3x_params; then
            # AWG 3.x: S1-S4 must all be >= 12 — the HeaderProtection nonce is read
            # from the first 12 bytes of the S-padding (amneziawg-go rejects the
            # config otherwise).
            AWG_S3=${AWG_S3:-$(shuf -i 12-55 -n 1)}
            AWG_S4=${AWG_S4:-$(shuf -i 12-20 -n 1)}
        else
            # AWG 2.0: S3/S4 padding
            AWG_S3=${AWG_S3:-$(shuf -i 8-55 -n 1)}
            AWG_S4=${AWG_S4:-$(shuf -i 4-20 -n 1)}
        fi
        generate_default_signatures
    else
        # AWG 1.5 fallback: single integer H values, no S3/S4 padding, no signatures
        AWG_H1=${AWG_H1:-$(shuf -i 5-2147483647 -n 1)}
        AWG_H2=${AWG_H2:-$(shuf -i 5-2147483647 -n 1)}
        AWG_H3=${AWG_H3:-$(shuf -i 5-2147483647 -n 1)}
        AWG_H4=${AWG_H4:-$(shuf -i 5-2147483647 -n 1)}
        AWG_S3=${AWG_S3:-0}
        AWG_S4=${AWG_S4:-0}
        AWG_I1=${AWG_I1:-}
        AWG_I2=${AWG_I2:-}
        AWG_I3=${AWG_I3:-}
        AWG_I4=${AWG_I4:-}
        AWG_I5=${AWG_I5:-}
    fi

    if awg_has_3x_params; then
        generate_awg3_params
    else
        # Not 3.x: keep 3.x params empty (e.g. after switching versions down)
        AWG_HEADER_PROTECTION_KEY=""
        AWG_CONTENT_PADDING=""
        AWG_REKEY_AFTER_TIME=""
        AWG_REKEY_TIMEOUT=""
        AWG_REJECT_AFTER_TIME=""
        AWG_KEEPALIVE_TIMEOUT=""
        AWG_MAX_HANDSHAKE_ATTEMPTS=""
    fi

    # Only reachable when the user pinned AWG_CONTENT_PADDING themselves — the
    # default above already stands down for RandomTrailers.
    if [[ "${AWG_RANDOM_TRAILERS}" == "on" ]] && [[ -n "${AWG_CONTENT_PADDING}" ]] &&
       [[ "${AWG_CONTENT_PADDING}" != "0" && "${AWG_CONTENT_PADDING}" != "0-0" ]]; then
        echo "**** WARNING: ContentPaddingAddition=${AWG_CONTENT_PADDING} is set together with  ****"
        echo "**** RandomTrailers=on. Content padding wins on the send path and suppresses ****"
        echo "**** the trailers, but the receiver still relaxes its packet-type matching — ****"
        echo "**** the risk of trailers with none of the obfuscation, plus roughly 22% of   ****"
        echo "**** download throughput. Set AWG_CONTENT_PADDING=0 to fix.                  ****"
    fi

    # Save params to file for persistence.
    # generate_confs also creates this dir, but it runs *after* us — without this
    # mkdir the write fails on a fresh install and awg_params is never created,
    # so the next start regenerates every parameter and invalidates peer confs.
    mkdir -p /config/server
    cat > /config/server/awg_params <<EOF
AWG_VERSION=$AWG_VERSION
AWG_JC=$AWG_JC
AWG_JMIN=$AWG_JMIN
AWG_JMAX=$AWG_JMAX
AWG_S1=$AWG_S1
AWG_S2=$AWG_S2
AWG_S3=$AWG_S3
AWG_S4=$AWG_S4
AWG_H1=$AWG_H1
AWG_H2=$AWG_H2
AWG_H3=$AWG_H3
AWG_H4=$AWG_H4
AWG_I1=$AWG_I1
AWG_I2=$AWG_I2
AWG_I3=$AWG_I3
AWG_I4=$AWG_I4
AWG_I5=$AWG_I5
AWG_HEADER_PROTECTION_KEY=$AWG_HEADER_PROTECTION_KEY
AWG_CONTENT_PADDING=$AWG_CONTENT_PADDING
AWG_REKEY_AFTER_TIME=$AWG_REKEY_AFTER_TIME
AWG_REKEY_TIMEOUT=$AWG_REKEY_TIMEOUT
AWG_REJECT_AFTER_TIME=$AWG_REJECT_AFTER_TIME
AWG_KEEPALIVE_TIMEOUT=$AWG_KEEPALIVE_TIMEOUT
AWG_MAX_HANDSHAKE_ATTEMPTS=$AWG_MAX_HANDSHAKE_ATTEMPTS
AWG_RANDOM_TRAILERS=$_rt_explicit
AWG_DISABLE_COOKIES=$_dc_explicit
EOF

    echo "**** AWG Obfuscation Parameters ****"
    echo "  Jc=$AWG_JC, Jmin=$AWG_JMIN, Jmax=$AWG_JMAX"
    echo "  S1=$AWG_S1, S2=$AWG_S2, S3=$AWG_S3, S4=$AWG_S4"
    echo "  H1=$AWG_H1, H2=$AWG_H2, H3=$AWG_H3, H4=$AWG_H4"
    if [[ -n "$AWG_I1" ]]; then
        echo "  I1-I5 Custom Protocol Signatures: enabled"
    else
        echo "  I1-I5 Custom Protocol Signatures: disabled (AWG 1.5 mode)"
    fi
    if awg_has_3x_params; then
        echo "  HeaderProtectionKey: set"
        echo "  ContentPaddingAddition=$AWG_CONTENT_PADDING"
        echo "  RekeyAfterTime=$AWG_REKEY_AFTER_TIME, RekeyTimeout=$AWG_REKEY_TIMEOUT"
        echo "  RejectAfterTime=$AWG_REJECT_AFTER_TIME, KeepaliveTimeout=$AWG_KEEPALIVE_TIMEOUT"
        echo "  MaxHandshakeAttempts=$AWG_MAX_HANDSHAKE_ATTEMPTS"
    fi
    if [[ -n "$AWG_RANDOM_TRAILERS" ]] || [[ -n "$AWG_DISABLE_COOKIES" ]]; then
        echo "  AWG 3.1 options: RandomTrailers=${AWG_RANDOM_TRAILERS:-unset}, DisableCookies=${AWG_DISABLE_COOKIES:-unset}"
    fi

    # Validation warnings
    if [[ "$AWG_JMIN" -gt "$AWG_JMAX" ]] 2>/dev/null; then
        echo "**** WARNING: Jmin ($AWG_JMIN) > Jmax ($AWG_JMAX) - junk packets may not work correctly ****"
    fi
    local s1_plus_56=$((AWG_S1 + 56))
    if [[ "$s1_plus_56" -eq "$AWG_S2" ]] 2>/dev/null; then
        echo "**** WARNING: S1+56 ($s1_plus_56) equals S2 ($AWG_S2) - this should be avoided ****"
    fi
    # Check H1-H4 uniqueness (only for fixed values, not ranges)
    if [[ "$AWG_H1" != *-* ]] && [[ "$AWG_H2" != *-* ]] && [[ "$AWG_H3" != *-* ]] && [[ "$AWG_H4" != *-* ]]; then
        local -A h_values
        for h_name in AWG_H1 AWG_H2 AWG_H3 AWG_H4; do
            local h_val="${!h_name}"
            if [[ -n "${h_values[$h_val]+x}" ]]; then
                echo "**** WARNING: $h_name has duplicate value $h_val (same as ${h_values[$h_val]}) - H1-H4 should be unique ****"
            fi
            h_values[$h_val]="$h_name"
        done
    fi

    # AWG 3.x validation warnings
    if awg_has_3x_params; then
        # S1-S4 >= 12 is a hard requirement of HeaderProtectionKey
        if [[ -n "${AWG_HEADER_PROTECTION_KEY}" ]]; then
            for _s_name in AWG_S1 AWG_S2 AWG_S3 AWG_S4; do
                if (( ${!_s_name} < 12 )) 2>/dev/null; then
                    echo "**** WARNING: ${_s_name} (${!_s_name}) < 12 - all S values must be >= 12 when HeaderProtectionKey is set, amneziawg-go will reject the config ****"
                fi
            done
        fi
        # Timer invariants (amneziawg-go device/timers.go)
        if (( $(range_lo "${AWG_REJECT_AFTER_TIME}") <= $(range_lo "${AWG_KEEPALIVE_TIMEOUT}") + $(range_lo "${AWG_REKEY_TIMEOUT}") )) 2>/dev/null; then
            echo "**** WARNING: RejectAfterTime lower bound (${AWG_REJECT_AFTER_TIME}) must be greater than KeepaliveTimeout.lo + RekeyTimeout.lo (${AWG_KEEPALIVE_TIMEOUT} + ${AWG_REKEY_TIMEOUT}) ****"
        fi
        if (( $(range_hi "${AWG_REKEY_AFTER_TIME}") >= $(range_lo "${AWG_REJECT_AFTER_TIME}") )) 2>/dev/null; then
            echo "**** WARNING: RekeyAfterTime upper bound (${AWG_REKEY_AFTER_TIME}) must be less than RejectAfterTime lower bound (${AWG_REJECT_AFTER_TIME}) ****"
        fi
        if (( $(range_lo "${AWG_MAX_HANDSHAKE_ATTEMPTS}") < 1 )) 2>/dev/null; then
            echo "**** WARNING: MaxHandshakeAttempts lower bound (${AWG_MAX_HANDSHAKE_ATTEMPTS}) must be >= 1 ****"
        fi
    fi
}

# Load saved AWG params as fallback (do NOT use source - it overrides env vars)
load_awg_params() {
    if [[ -f /config/server/awg_params ]]; then
        AWG_VERSION=${AWG_VERSION:-$(grep "^AWG_VERSION=" /config/server/awg_params | cut -d= -f2)}
        AWG_JC=${AWG_JC:-$(grep "^AWG_JC=" /config/server/awg_params | cut -d= -f2)}
        AWG_JMIN=${AWG_JMIN:-$(grep "^AWG_JMIN=" /config/server/awg_params | cut -d= -f2)}
        AWG_JMAX=${AWG_JMAX:-$(grep "^AWG_JMAX=" /config/server/awg_params | cut -d= -f2)}
        AWG_S1=${AWG_S1:-$(grep "^AWG_S1=" /config/server/awg_params | cut -d= -f2)}
        AWG_S2=${AWG_S2:-$(grep "^AWG_S2=" /config/server/awg_params | cut -d= -f2)}
        AWG_S3=${AWG_S3:-$(grep "^AWG_S3=" /config/server/awg_params | cut -d= -f2)}
        AWG_S4=${AWG_S4:-$(grep "^AWG_S4=" /config/server/awg_params | cut -d= -f2)}
        AWG_H1=${AWG_H1:-$(grep "^AWG_H1=" /config/server/awg_params | cut -d= -f2)}
        AWG_H2=${AWG_H2:-$(grep "^AWG_H2=" /config/server/awg_params | cut -d= -f2)}
        AWG_H3=${AWG_H3:-$(grep "^AWG_H3=" /config/server/awg_params | cut -d= -f2)}
        AWG_H4=${AWG_H4:-$(grep "^AWG_H4=" /config/server/awg_params | cut -d= -f2)}
        AWG_I1=${AWG_I1:-$(grep "^AWG_I1=" /config/server/awg_params | cut -d= -f2-)}
        AWG_I2=${AWG_I2:-$(grep "^AWG_I2=" /config/server/awg_params | cut -d= -f2-)}
        AWG_I3=${AWG_I3:-$(grep "^AWG_I3=" /config/server/awg_params | cut -d= -f2-)}
        AWG_I4=${AWG_I4:-$(grep "^AWG_I4=" /config/server/awg_params | cut -d= -f2-)}
        AWG_I5=${AWG_I5:-$(grep "^AWG_I5=" /config/server/awg_params | cut -d= -f2-)}
        AWG_HEADER_PROTECTION_KEY=${AWG_HEADER_PROTECTION_KEY:-$(grep "^AWG_HEADER_PROTECTION_KEY=" /config/server/awg_params | cut -d= -f2-)}
        AWG_CONTENT_PADDING=${AWG_CONTENT_PADDING:-$(grep "^AWG_CONTENT_PADDING=" /config/server/awg_params | cut -d= -f2-)}
        AWG_REKEY_AFTER_TIME=${AWG_REKEY_AFTER_TIME:-$(grep "^AWG_REKEY_AFTER_TIME=" /config/server/awg_params | cut -d= -f2-)}
        AWG_REKEY_TIMEOUT=${AWG_REKEY_TIMEOUT:-$(grep "^AWG_REKEY_TIMEOUT=" /config/server/awg_params | cut -d= -f2-)}
        AWG_REJECT_AFTER_TIME=${AWG_REJECT_AFTER_TIME:-$(grep "^AWG_REJECT_AFTER_TIME=" /config/server/awg_params | cut -d= -f2-)}
        AWG_KEEPALIVE_TIMEOUT=${AWG_KEEPALIVE_TIMEOUT:-$(grep "^AWG_KEEPALIVE_TIMEOUT=" /config/server/awg_params | cut -d= -f2-)}
        AWG_MAX_HANDSHAKE_ATTEMPTS=${AWG_MAX_HANDSHAKE_ATTEMPTS:-$(grep "^AWG_MAX_HANDSHAKE_ATTEMPTS=" /config/server/awg_params | cut -d= -f2-)}
        AWG_RANDOM_TRAILERS=${AWG_RANDOM_TRAILERS:-$(grep "^AWG_RANDOM_TRAILERS=" /config/server/awg_params | cut -d= -f2)}
        AWG_DISABLE_COOKIES=${AWG_DISABLE_COOKIES:-$(grep "^AWG_DISABLE_COOKIES=" /config/server/awg_params | cut -d= -f2)}
    fi
}

# Append I1-I5 to a config file if set (used for server conf, which has no [Peer] section yet)
append_awg_signatures() {
    local conf_file=$1
    [[ -n "$AWG_I1" ]] && echo "I1 = ${AWG_I1}" >> "$conf_file"
    [[ -n "$AWG_I2" ]] && echo "I2 = ${AWG_I2}" >> "$conf_file"
    [[ -n "$AWG_I3" ]] && echo "I3 = ${AWG_I3}" >> "$conf_file"
    [[ -n "$AWG_I4" ]] && echo "I4 = ${AWG_I4}" >> "$conf_file"
    [[ -n "$AWG_I5" ]] && echo "I5 = ${AWG_I5}" >> "$conf_file"
}

# Insert I1-I5 into the [Interface] section of a peer conf, before the [Peer]
# line — the Amnezia app only looks for signature packets in [Interface].
#
# Empty values are skipped rather than written as a bare "I2 =". awg rejects an
# empty value outright ("Line unrecognized: `I2='"), which makes the whole conf
# unloadable by awg-quick, by `awg setconf`, and by this image in client mode —
# so a peer conf carrying placeholders only works in GUI clients with a more
# forgiving parser. Earlier versions wrote them deliberately, on the theory that
# their presence signalled AWG 2.0+ to the Amnezia app; version detection
# actually keys off the H1-H4 range format, which is emitted independently and
# is unaffected by this. The server-side append_awg_signatures() has always
# skipped empties, so this also makes the two sides agree.
append_awg_signatures_to_interface() {
    local conf_file=$1
    local sig_block="" _n _var _v
    for _n in 1 2 3 4 5; do
        _var="AWG_I${_n}"
        _v="${!_var:-}"
        [[ -n "$_v" ]] && sig_block+="I${_n} = ${_v}"$'\n'
    done
    [[ -z "$sig_block" ]] && return 0
    local tmp
    tmp=$(awk -v block="$sig_block" '
        /^\[Peer\]/ && !done { printf "%s", block; done=1 }
        { print }
    ' "$conf_file")
    printf '%s\n' "$tmp" > "$conf_file"
}

# Append AWG 3.0 params to the server conf (called before any [Peer] section exists)
append_awg3_params() {
    local conf_file=$1
    awg_has_3x_params || return 0
    cat >> "$conf_file" <<EOF
HeaderProtectionKey = ${AWG_HEADER_PROTECTION_KEY}
ContentPaddingAddition = ${AWG_CONTENT_PADDING}
RekeyAfterTime = ${AWG_REKEY_AFTER_TIME}
RekeyTimeout = ${AWG_REKEY_TIMEOUT}
RejectAfterTime = ${AWG_REJECT_AFTER_TIME}
KeepaliveTimeout = ${AWG_KEEPALIVE_TIMEOUT}
MaxHandshakeAttempts = ${AWG_MAX_HANDSHAKE_ATTEMPTS}
EOF
}

# Insert AWG 3.0 params into the [Interface] section of a peer conf (before the [Peer] line)
append_awg3_params_to_interface() {
    local conf_file=$1
    awg_has_3x_params || return 0
    local sig_block="HeaderProtectionKey = ${AWG_HEADER_PROTECTION_KEY}"$'\n'
    sig_block+="ContentPaddingAddition = ${AWG_CONTENT_PADDING}"$'\n'
    sig_block+="RekeyAfterTime = ${AWG_REKEY_AFTER_TIME}"$'\n'
    sig_block+="RekeyTimeout = ${AWG_REKEY_TIMEOUT}"$'\n'
    sig_block+="RejectAfterTime = ${AWG_REJECT_AFTER_TIME}"$'\n'
    sig_block+="KeepaliveTimeout = ${AWG_KEEPALIVE_TIMEOUT}"$'\n'
    sig_block+="MaxHandshakeAttempts = ${AWG_MAX_HANDSHAKE_ATTEMPTS}"$'\n'
    local tmp
    tmp=$(awk -v block="$sig_block" '
        /^\[Peer\]/ && !done { printf "%s", block; done=1 }
        { print }
    ' "$conf_file")
    printf '%s\n' "$tmp" > "$conf_file"
}

# Warn when the AWG 3.1 switches are requested against a kernel module that
# predates them. awg setconf rejects the entire config with "Line unrecognized"
# in that case, so the tunnel fails to come up rather than losing one option.
# The bundled userspace amneziawg-go is a 3.1 build and always supports them.
check_awg31_kernel_support() {
    [[ "${AWG_RANDOM_TRAILERS}" == "on" || "${AWG_DISABLE_COOKIES}" == "on" ]] || return 0
    [[ -n "${WG_QUICK_USERSPACE_IMPLEMENTATION:-}" ]] && return 0
    [[ -r /sys/module/amneziawg/version ]] || return 0
    local modver major minor
    modver=$(cat /sys/module/amneziawg/version)
    major=${modver%%.*}
    minor=${modver#*.}; minor=${minor%%.*}
    # Stay silent on anything we cannot read as a number ("v3.1.0", a
    # git-describe string, a distro suffix). In bash arithmetic a non-numeric
    # word is resolved as a variable name and evaluates to 0, which would make
    # a perfectly capable module look ancient and fire a false warning.
    [[ "${major}" =~ ^[0-9]+$ && "${minor}" =~ ^[0-9]+$ ]] || return 0
    if (( major < 3 || (major == 3 && minor < 1) )); then
        echo "**** WARNING: RandomTrailers/DisableCookies need amneziawg kernel module 3.1 or newer, but ${modver} is loaded ****"
        echo "****          The bundled awg parses these keys, so the failure comes from the kernel: awg-quick reports      ****"
        echo "****          \"Unable to modify interface: Invalid argument\" and the tunnel does not come up.                ****"
        echo "****          Upgrade the host module (amneziawg-dkms), or set AWG_RANDOM_TRAILERS=off and                   ****"
        echo "****          AWG_DISABLE_COOKIES=off, which omits the keys entirely.                                         ****"
    fi
}

# Build the AWG 3.1 [Interface] switch block into the caller's BLOCK_OUT
# variable, or leave it empty if neither switch is set. These are independent
# of AWG_VERSION, so unlike the 3.x parameter block they are written for any
# version the user pairs them with.
#
# The block is returned via a variable rather than stdout on purpose: command
# substitution strips trailing newlines, which would glue the last option onto
# the following [Peer] line and make awg setconf reject the whole config.
# Only "on" emits a key. "off" is deliberately written as an absent key rather
# than "= off": off is already the endpoint default, so the two are functionally
# identical, and omitting it keeps the config parseable by an older amneziawg
# that does not know the key at all. That makes "off" the way out of a tunnel
# broken by these switches — an empty value cannot serve that role, because s6
# drops empty variables from container_environment and the script would see it
# as absent, i.e. "reuse the saved value".
awg31_options_block() {
    BLOCK_OUT=""
    [[ "${AWG_RANDOM_TRAILERS}" == "on" ]] && BLOCK_OUT+="RandomTrailers = on"$'\n'
    [[ "${AWG_DISABLE_COOKIES}" == "on" ]] && BLOCK_OUT+="DisableCookies = on"$'\n'
}

# Append the AWG 3.1 options to the server conf (called before any [Peer] exists)
append_awg31_options() {
    local conf_file=$1
    local BLOCK_OUT
    awg31_options_block
    [[ -z "${BLOCK_OUT}" ]] && return 0
    printf '%s' "${BLOCK_OUT}" >> "$conf_file"
}

# Insert the AWG 3.1 options into the [Interface] section of a peer conf
# (before the [Peer] line)
append_awg31_options_to_interface() {
    local conf_file=$1
    local BLOCK_OUT
    awg31_options_block
    [[ -z "${BLOCK_OUT}" ]] && return 0
    local tmp
    tmp=$(awk -v block="${BLOCK_OUT}" '
        /^\[Peer\]/ && !done { printf "%s", block; done=1 }
        { print }
    ' "$conf_file")
    printf '%s\n' "$tmp" > "$conf_file"
}

# ============================================================================
# Config generation (matches LinuxServer docker-wireguard pattern)
# ============================================================================

generate_confs () {
    mkdir -p /config/server
    if [[ ! -f /config/server/privatekey-server ]]; then
        umask 077
        awg genkey | tee /config/server/privatekey-server | awg pubkey > /config/server/publickey-server
    fi
    eval "$(printf %s)
    cat <<DUDE > /config/wg_confs/wg0.conf
$(cat /config/templates/server.conf)

DUDE"
    # Append I1-I5 signature packets to server conf
    append_awg_signatures /config/wg_confs/wg0.conf
    # Append AWG 3.x params to server conf (no-op unless AWG_VERSION is 3.0/3.1)
    append_awg3_params /config/wg_confs/wg0.conf
    # Append AWG 3.1 switches to server conf (no-op unless either is set)
    append_awg31_options /config/wg_confs/wg0.conf
    for i in "${PEERS_ARRAY[@]}"; do
        if [[ ! "${i}" =~ ^[[:alnum:]]+$ ]]; then
            echo "**** Peer ${i} contains non-alphanumeric characters and thus will be skipped. No config for peer ${i} will be generated. ****"
        else
            if [[ "${i}" =~ ^[0-9]+$ ]]; then
                PEER_ID="peer${i}"
            else
                PEER_ID="peer_${i}"
            fi
            mkdir -p "/config/${PEER_ID}"
            if [[ ! -f "/config/${PEER_ID}/privatekey-${PEER_ID}" ]]; then
                umask 077
                awg genkey | tee "/config/${PEER_ID}/privatekey-${PEER_ID}" | awg pubkey > "/config/${PEER_ID}/publickey-${PEER_ID}"
                awg genpsk > "/config/${PEER_ID}/presharedkey-${PEER_ID}"
            fi
            if [[ -f "/config/${PEER_ID}/${PEER_ID}.conf" ]]; then
                CLIENT_IP=$(grep "Address" "/config/${PEER_ID}/${PEER_ID}.conf" | awk '{print $NF}')
                if [[ -n "${ORIG_INTERFACE}" ]] && [[ "${INTERFACE}" != "${ORIG_INTERFACE}" ]]; then
                    CLIENT_IP="${CLIENT_IP//${ORIG_INTERFACE}/${INTERFACE}}"
                fi
            else
                for idx in {2..254}; do
                    PROPOSED_IP="${INTERFACE}.${idx}"
                    if ! grep -q -R "${PROPOSED_IP}" /config/peer*/*.conf 2>/dev/null && ([[ -z "${ORIG_INTERFACE}" ]] || ! grep -q -R "${ORIG_INTERFACE}.${idx}" /config/peer*/*.conf 2>/dev/null); then
                        CLIENT_IP="${PROPOSED_IP}"
                        break
                    fi
                done
            fi
            if [[ -f "/config/${PEER_ID}/presharedkey-${PEER_ID}" ]]; then
                # create peer conf with presharedkey
                eval "$(printf %s)
                cat <<DUDE > /config/${PEER_ID}/${PEER_ID}.conf
$(cat /config/templates/peer.conf)
DUDE"
                # Insert I1-I5 into [Interface] section of peer conf
                append_awg_signatures_to_interface "/config/${PEER_ID}/${PEER_ID}.conf"
                # Insert AWG 3.x params into [Interface] section (no-op unless AWG_VERSION is 3.0/3.1)
                append_awg3_params_to_interface "/config/${PEER_ID}/${PEER_ID}.conf"
                # Insert AWG 3.1 switches into [Interface] section (no-op unless either is set)
                append_awg31_options_to_interface "/config/${PEER_ID}/${PEER_ID}.conf"
                # add peer info to server conf with presharedkey
                cat <<DUDE >> /config/wg_confs/wg0.conf
[Peer]
# ${PEER_ID}
PublicKey = $(cat "/config/${PEER_ID}/publickey-${PEER_ID}")
PresharedKey = $(cat "/config/${PEER_ID}/presharedkey-${PEER_ID}")
DUDE
            else
                echo "**** Existing keys with no preshared key found for ${PEER_ID}, creating confs without preshared key for backwards compatibility ****"
                # create peer conf without presharedkey
                eval "$(printf %s)
                cat <<DUDE > /config/${PEER_ID}/${PEER_ID}.conf
$(sed '/PresharedKey/d' "/config/templates/peer.conf")
DUDE"
                # Insert I1-I5 into [Interface] section of peer conf
                append_awg_signatures_to_interface "/config/${PEER_ID}/${PEER_ID}.conf"
                # Insert AWG 3.x params into [Interface] section (no-op unless AWG_VERSION is 3.0/3.1)
                append_awg3_params_to_interface "/config/${PEER_ID}/${PEER_ID}.conf"
                # Insert AWG 3.1 switches into [Interface] section (no-op unless either is set)
                append_awg31_options_to_interface "/config/${PEER_ID}/${PEER_ID}.conf"
                # add peer info to server conf without presharedkey
                cat <<DUDE >> /config/wg_confs/wg0.conf
[Peer]
# ${PEER_ID}
PublicKey = $(cat "/config/${PEER_ID}/publickey-${PEER_ID}")
DUDE
            fi
            SERVER_ALLOWEDIPS=SERVER_ALLOWEDIPS_PEER_${i}
            # add peer's allowedips to server conf
            if [[ -n "${!SERVER_ALLOWEDIPS}" ]]; then
                echo "Adding ${!SERVER_ALLOWEDIPS} to wg0.conf's AllowedIPs for peer ${i}"
                cat <<DUDE >> /config/wg_confs/wg0.conf
AllowedIPs = ${CLIENT_IP}/32,${!SERVER_ALLOWEDIPS}
DUDE
            else
                cat <<DUDE >> /config/wg_confs/wg0.conf
AllowedIPs = ${CLIENT_IP}/32
DUDE
            fi
            # add PersistentKeepalive if the peer is specified
            if [[ -n "${PERSISTENTKEEPALIVE_PEERS_ARRAY}" ]] && ([[ "${PERSISTENTKEEPALIVE_PEERS_ARRAY[0]}" = "all" ]] || printf '%s\0' "${PERSISTENTKEEPALIVE_PEERS_ARRAY[@]}" | grep -Fxqz -- "${i}"); then
                cat <<DUDE >> /config/wg_confs/wg0.conf
PersistentKeepalive = 25

DUDE
            else
                cat <<DUDE >> /config/wg_confs/wg0.conf

DUDE
            fi
            if [[ -z "${LOG_CONFS}" ]] || [[ "${LOG_CONFS}" = "true" ]]; then
                echo "PEER ${i} QR code (conf file is saved under /config/${PEER_ID}):"
                qrencode -t ansiutf8 < "/config/${PEER_ID}/${PEER_ID}.conf"
            else
                echo "PEER ${i} conf and QR code png saved in /config/${PEER_ID}"
            fi
            qrencode -o "/config/${PEER_ID}/${PEER_ID}.png" < "/config/${PEER_ID}/${PEER_ID}.conf"
        fi
    done
}

save_vars () {
    cat <<DUDE > /config/.donoteditthisfile
ORIG_SERVERURL="$SERVERURL"
ORIG_SERVERPORT="$SERVERPORT"
ORIG_PEERDNS="$PEERDNS"
ORIG_PEERS="$PEERS"
ORIG_INTERFACE="$INTERFACE"
ORIG_ALLOWEDIPS="$ALLOWEDIPS"
ORIG_PERSISTENTKEEPALIVE_PEERS="$PERSISTENTKEEPALIVE_PEERS"
ORIG_AWG_VERSION="$AWG_VERSION"
ORIG_AWG_JC="$AWG_JC"
ORIG_AWG_JMIN="$AWG_JMIN"
ORIG_AWG_JMAX="$AWG_JMAX"
ORIG_AWG_S1="$AWG_S1"
ORIG_AWG_S2="$AWG_S2"
ORIG_AWG_S3="$AWG_S3"
ORIG_AWG_S4="$AWG_S4"
ORIG_AWG_H1="$AWG_H1"
ORIG_AWG_H2="$AWG_H2"
ORIG_AWG_H3="$AWG_H3"
ORIG_AWG_H4="$AWG_H4"
ORIG_AWG_I1="$AWG_I1"
ORIG_AWG_I2="$AWG_I2"
ORIG_AWG_I3="$AWG_I3"
ORIG_AWG_I4="$AWG_I4"
ORIG_AWG_I5="$AWG_I5"
ORIG_AWG_HEADER_PROTECTION_KEY="$AWG_HEADER_PROTECTION_KEY"
ORIG_AWG_CONTENT_PADDING="$AWG_CONTENT_PADDING"
ORIG_AWG_REKEY_AFTER_TIME="$AWG_REKEY_AFTER_TIME"
ORIG_AWG_REKEY_TIMEOUT="$AWG_REKEY_TIMEOUT"
ORIG_AWG_REJECT_AFTER_TIME="$AWG_REJECT_AFTER_TIME"
ORIG_AWG_KEEPALIVE_TIMEOUT="$AWG_KEEPALIVE_TIMEOUT"
ORIG_AWG_MAX_HANDSHAKE_ATTEMPTS="$AWG_MAX_HANDSHAKE_ATTEMPTS"
ORIG_AWG_RANDOM_TRAILERS="$AWG_RANDOM_TRAILERS"
ORIG_AWG_DISABLE_COOKIES="$AWG_DISABLE_COOKIES"
DUDE
}

if [[ -n "$PEERS" ]]; then
    echo "**** Server mode is selected ****"
    if [[ "$PEERS" =~ ^[0-9]+$ ]] && ! [[ "$PEERS" = *,* ]]; then
        mapfile -t PEERS_ARRAY < <(seq 1 "${PEERS}")
    else
        mapfile -t PEERS_ARRAY < <(echo "${PEERS}" | tr ',' '\n')
    fi
    if [[ ${#PEERS_ARRAY[@]} -gt 253 ]]; then
        echo "**** ERROR: Too many peers (${#PEERS_ARRAY[@]}). Maximum is 253 for a /24 subnet ****"
        sleep infinity
    fi
    if [[ -n "${PERSISTENTKEEPALIVE_PEERS}" ]]; then
        echo "**** PersistentKeepalive will be set for: ${PERSISTENTKEEPALIVE_PEERS/,/ } ****"
        mapfile -t PERSISTENTKEEPALIVE_PEERS_ARRAY < <(echo "${PERSISTENTKEEPALIVE_PEERS}" | tr ',' '\n')
    fi
    if [[ -z "$SERVERURL" ]] || [[ "$SERVERURL" = "auto" ]]; then
        SERVERURL=$(curl -s -4 icanhazip.com)
        echo "**** SERVERURL var is either not set or is set to \"auto\", setting external IP to auto detected value of $SERVERURL ****"
    else
        echo "**** External server address is set to $SERVERURL ****"
    fi
    SERVERPORT=${SERVERPORT:-51820}
    echo "**** External server port is set to ${SERVERPORT}. Make sure that port is properly forwarded to port 51820 inside this container ****"
    INTERNAL_SUBNET=${INTERNAL_SUBNET:-10.13.13.0}
    echo "**** Internal subnet is set to $INTERNAL_SUBNET ****"
    INTERFACE=$(echo "$INTERNAL_SUBNET" | awk 'BEGIN{FS=OFS="."} NF--')
    ALLOWEDIPS=${ALLOWEDIPS:-0.0.0.0/0, ::/0}
    echo "**** AllowedIPs for peers $ALLOWEDIPS ****"
    if [[ -z "$PEERDNS" ]] || [[ "$PEERDNS" = "auto" ]]; then
        PEERDNS="${INTERFACE}.1"
        echo "**** PEERDNS var is either not set or is set to \"auto\", setting peer DNS to ${INTERFACE}.1 to use the container host's DNS. ****"
    else
        echo "**** Peer DNS servers will be set to $PEERDNS ****"
    fi

    # Load saved AWG params as fallback, then generate/validate
    load_awg_params
    generate_awg_params
    check_awg31_kernel_support

    if [[ ! -f /config/wg_confs/wg0.conf ]]; then
        echo "**** No wg0.conf found (maybe an initial install), generating 1 server and ${PEERS} peer/client confs ****"
        generate_confs
        save_vars
    else
        echo "**** Server mode is selected ****"
        if [[ -f /config/.donoteditthisfile ]]; then
            . /config/.donoteditthisfile
        fi
        if [[ "$SERVERURL" != "$ORIG_SERVERURL" ]] || \
           [[ "$SERVERPORT" != "$ORIG_SERVERPORT" ]] || \
           [[ "$PEERDNS" != "$ORIG_PEERDNS" ]] || \
           [[ "$PEERS" != "$ORIG_PEERS" ]] || \
           [[ "$INTERFACE" != "$ORIG_INTERFACE" ]] || \
           [[ "$ALLOWEDIPS" != "$ORIG_ALLOWEDIPS" ]] || \
           [[ "$PERSISTENTKEEPALIVE_PEERS" != "$ORIG_PERSISTENTKEEPALIVE_PEERS" ]] || \
           [[ "$AWG_VERSION" != "$ORIG_AWG_VERSION" ]] || \
           [[ "$AWG_JC" != "$ORIG_AWG_JC" ]] || \
           [[ "$AWG_JMIN" != "$ORIG_AWG_JMIN" ]] || \
           [[ "$AWG_JMAX" != "$ORIG_AWG_JMAX" ]] || \
           [[ "$AWG_S1" != "$ORIG_AWG_S1" ]] || \
           [[ "$AWG_S2" != "$ORIG_AWG_S2" ]] || \
           [[ "$AWG_S3" != "$ORIG_AWG_S3" ]] || \
           [[ "$AWG_S4" != "$ORIG_AWG_S4" ]] || \
           [[ "$AWG_H1" != "$ORIG_AWG_H1" ]] || \
           [[ "$AWG_H2" != "$ORIG_AWG_H2" ]] || \
           [[ "$AWG_H3" != "$ORIG_AWG_H3" ]] || \
           [[ "$AWG_H4" != "$ORIG_AWG_H4" ]] || \
           [[ "$AWG_I1" != "$ORIG_AWG_I1" ]] || \
           [[ "$AWG_I2" != "$ORIG_AWG_I2" ]] || \
           [[ "$AWG_I3" != "$ORIG_AWG_I3" ]] || \
           [[ "$AWG_I4" != "$ORIG_AWG_I4" ]] || \
           [[ "$AWG_I5" != "$ORIG_AWG_I5" ]] || \
           [[ "$AWG_HEADER_PROTECTION_KEY" != "$ORIG_AWG_HEADER_PROTECTION_KEY" ]] || \
           [[ "$AWG_CONTENT_PADDING" != "$ORIG_AWG_CONTENT_PADDING" ]] || \
           [[ "$AWG_REKEY_AFTER_TIME" != "$ORIG_AWG_REKEY_AFTER_TIME" ]] || \
           [[ "$AWG_REKEY_TIMEOUT" != "$ORIG_AWG_REKEY_TIMEOUT" ]] || \
           [[ "$AWG_REJECT_AFTER_TIME" != "$ORIG_AWG_REJECT_AFTER_TIME" ]] || \
           [[ "$AWG_KEEPALIVE_TIMEOUT" != "$ORIG_AWG_KEEPALIVE_TIMEOUT" ]] || \
           [[ "$AWG_MAX_HANDSHAKE_ATTEMPTS" != "$ORIG_AWG_MAX_HANDSHAKE_ATTEMPTS" ]] || \
           [[ "$AWG_RANDOM_TRAILERS" != "$ORIG_AWG_RANDOM_TRAILERS" ]] || \
           [[ "$AWG_DISABLE_COOKIES" != "$ORIG_AWG_DISABLE_COOKIES" ]]; then
            echo "**** Server related environment variables changed, regenerating 1 server and ${PEERS} peer/client confs ****"
            generate_confs
            save_vars
        else
            echo "**** No changes to parameters. Existing configs are used. ****"
        fi
    fi
else
    echo "**** Client mode selected. ****"
    USE_COREDNS="${USE_COREDNS,,}"
    printf %s "${USE_COREDNS:-false}" > /run/s6-overlay/container_environment/USE_COREDNS
fi

# set up CoreDNS
if [[ ! -f /config/coredns/Corefile ]]; then
    cp /defaults/Corefile /config/coredns/Corefile
fi

# let openresolv take control of resolv.conf
resolvconf -a control 2>/dev/null < /etc/resolv.conf
resolvconf -u

# permissions
lsiown -R abc:abc \
    /config
